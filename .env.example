# ==============================================================================
# Multi-Region HA Data Platform - Environment Configuration Template
# Copy this file to .env and replace placeholder values with your credentials.
# NEVER commit the active .env file or sensitive secrets to version control.
# ==============================================================================

# MinIO Administrative Root Credentials
MINIO_ROOT_USER=<REPLACE_WITH_ADMIN_USER>
MINIO_ROOT_PASSWORD=<REPLACE_WITH_STRONG_ADMIN_PASSWORD_MIN_8_CHARS>

# Dedicated Replication Service User Credentials (used for cross-region replication)
REPL_USER=<REPLACE_WITH_REPLICATION_USER>
REPL_PASSWORD=<REPLACE_WITH_STRONG_REPLICATION_PASSWORD_MIN_8_CHARS>

# Target S3 Data Bucket Name
BUCKET_NAME=data-bucket

# Regional Port Bindings on Host (Direct inspection/debug endpoints)
REGION_A_PORT=9001
REGION_A_CONSOLE_PORT=9002
REGION_B_PORT=9011
REGION_B_CONSOLE_PORT=9012

# Global Endpoint Port (Nginx Reverse Proxy)
GLOBAL_PORT=8000

# Failover Controller Settings
HEALTHCHECK_INTERVAL_SECONDS=1.0
PROBE_TIMEOUT_SECONDS=0.5
FAILOVER_THRESHOLD=3
